# ─────────────────────────────────────────────────────────────
# HookStream — Webhook CRM Console · Environment Variables
# Copy this file to .env and fill in your own values.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + Drizzle ORM) ──────────────────────
# Server-side only connection string.
# Local dev: postgresql://postgres:password@localhost:5432/webhook
# Production: Hosted Postgres URI (e.g., Supabase / Neon / Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook

# ── Webhook Transmitter Target (Outbound - Send) ─────────────
# Default destination endpoint for sending webhook data from UI
NEXT_PUBLIC_WEBHOOK_URL=https://bribe-claw-unguarded.ngrok-free.dev/api/webhook/577d659e-660d-4633-ad00-b75a80ed1135/

# ── Webhook Receiver / App URL (Inbound - Receive) ───────────
# Local dev: Put your active Ngrok URL (e.g., https://xyz.ngrok-free.app)
# Production: Not needed! The app automatically detects your live domain (or set NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_NGROK_URL=https://0ba3-2401-4900-8811-3a12-9076-8bbe-911d-732a.ngrok-free.app
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ── Webhook Receiver / Smart Deduplication (server-side) ─────
# Time window (seconds) for phone-number dedupe.
WEBHOOK_DEDUPE_WINDOW_SECONDS=60
